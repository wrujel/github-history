{
  "name": "github-history",
  "version": "1.0.0",
  "description": "Github History App - run backend and frontend together",
  "author": "wrujel",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"pnpm:dev:backend\" \"pnpm:dev:frontend\"",
    "dev:backend": "pnpm --dir backend run start:dev",
    "dev:frontend": "pnpm --dir frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
